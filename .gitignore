# Secrets — never commit
.env

# Local dev
.venv/
logs/
__pycache__/
*.pyc
.DS_Store

# State — lives on the deploy volume, not in git
*.db

# Generated by check.py (bundled assets in public/ ARE committed)
public/index.html
# One per city, from cities.py's `file`. Add the next city's here with it.
public/la.html
public/404.html
public/og.png
public/welcome-montage.jpg
public/dog/
public/rescue/
public/rescues.html
# The shared stylesheet and share kit, plus every non-default city's
# copy of them and its rescue index. Globs rather than one line per
# city so adding a city doesn't quietly start committing build output;
# public/assets/ is real source and matches none of these.
public/app.css
public/share.js
public/*/app.css
public/*/share.js
public/*/rescues.html
public/sitemap.xml

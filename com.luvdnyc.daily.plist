<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.luvdnyc.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/cory/luvd-nyc/run_daily.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/cory/luvd-nyc</string>

  <!-- 5:30am, before the morning email would go out. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>5</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <!-- If the Mac was asleep at 5:30, run as soon as it wakes. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/cory/luvd-nyc/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/cory/luvd-nyc/logs/launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>

# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Petfinder API (free: https://www.petfinder.com/developers/)
PETFINDER_KEY=
PETFINDER_SECRET=

# Resend (free: https://resend.com) — the "re_..." key
RESEND_API_KEY=
# Until you verify your own domain in Resend, this test sender works:
FROM_EMAIL=Dog Finder <onboarding@resend.dev>

# Anthropic API key for the plain-English matching (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Public URL of the LUVD NYC page (used in emails)
SITE_URL=http://localhost:8000

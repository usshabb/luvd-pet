# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# No keys are needed to fetch dogs — every rescue source is a public endpoint.
# (The Petfinder API that used to need one was decommissioned 2 Dec 2025.)

# Mandrill (Mailchimp Transactional) — the "md-..." key
MANDRILL_API_KEY=
# Sending address. Must be a real mailbox on a domain verified in Mandrill.
FROM_EMAIL=LUVD <cory@luvd.com>

# Anthropic API key for the plain-English matching (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Public URL of the LUVD page (used in emails)
SITE_URL=http://localhost:8000

# Google Apps Script webhook that mirrors the subscribers table to a Sheet
# (see sheet_webhook.gs). Optional: unset disables the mirror entirely, and
# SQLite stays the source of truth either way. The URL *is* the secret —
# anyone holding it can rewrite the sheet — so in production it belongs in
# Fly secrets, never in the repo.
SHEET_WEBHOOK_URL=

# Password for the operator-only endpoints: /subscribers, /report and
# /interest-report. Pass it as ?token=... or an X-Admin-Token header.
#
# Fails closed: while this is unset those three routes answer 404 for everyone,
# including you. That is deliberate — they used to serve the subscriber list to
# anyone who typed the URL. Generate one with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# In production it belongs in Fly secrets, never in the repo.
ADMIN_TOKEN=
